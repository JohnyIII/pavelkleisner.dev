---
import "../styles/global.css";
import Nav from "@/components/Nav.astro";

const { title, description, noindex = false } = Astro.props;

const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : Astro.url.pathname + "/";
const lang = pathname.startsWith("/cz") ? "cz" : "en";

const defaults = {
    en: {
        title: "Pavel Kleisner - Senior Backend Engineer, Team Lead & AI Tooling",
        description: "Independent senior backend-heavy full-stack engineer and team lead focused on Kotlin, Java, Spring, PostgreSQL, integrations, and reliable production systems. Also builds small tools that let AI agents work with real systems.",
    },
    cz: {
        title: "Pavel Kleisner - Senior backend vývojář, team lead & AI nástroje",
        description: "Nezávislý senior backend-heavy full-stack vývojář a team lead zaměřený na Kotlin, Javu, Spring, PostgreSQL, integrace a spolehlivé produkční systémy. Staví i malé nástroje, díky kterým můžou AI agenti pracovat s reálnými systémy.",
    },
};

const pageTitle = title ?? defaults[lang].title;
const pageDescription = description ?? defaults[lang].description;

const buildDate = new Date().toISOString().slice(0, 10);
const labels = lang === "cz"
    ? { source: "Zdrojový kód webu", updated: "Upraveno" }
    : { source: "Source of this site", updated: "Updated" };

const siteUrl = "https://pavelkleisner.dev";
const pairs = [["/", "/cz/"], ["/about/", "/cz/o-mne/"], ["/projects/", "/cz/projekty/"], ["/contact/", "/cz/kontakt/"]];
const pair = noindex ? undefined : pairs.find(([en, cs]) => en === pathname || cs === pathname);
const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Pavel Kleisner",
    url: siteUrl,
    jobTitle: "Independent Senior Backend-heavy Full-stack Engineer / Team Lead",
    description: defaults.en.description,
    knowsAbout: [
        "Kotlin", "Java", "Spring Framework", "PostgreSQL", "Kafka",
        "System integration", "Production releases", "B2B integrations",
        "Backend architecture", "Incident analysis",
        "AI-assisted software development", "Model Context Protocol",
    ],
    address: {
        "@type": "PostalAddress",
        addressLocality: "Prague",
        addressCountry: "CZ",
    },
    sameAs: [
        "https://github.com/JohnyIII",
        "https://www.linkedin.com/in/pavel-kleisner-895989129/",
    ],
};
---

<!doctype html>
<html lang={lang === "cz" ? "cs" : "en"} data-theme="void">
<head>
	<meta charset="utf-8" />
	<Fragment set:html={`<!--
	  Hi there. Yes, this site is hand-built.
	  Astro + TypeScript + Tailwind, hosted on Cloudflare Pages.
	  Source: https://github.com/JohnyIII/pavelkleisner.dev
	  -- Pavel
	-->`} />
	<script is:inline>
		(function () {
			try {
				var stored = localStorage.getItem("pavelkleisner-theme");
				if (stored === "void" || stored === "paper") {
					document.documentElement.dataset.theme = stored;
					return;
				}
			} catch {}
			var prefersLight = typeof window !== "undefined"
				&& window.matchMedia
				&& window.matchMedia("(prefers-color-scheme: light)").matches;
			document.documentElement.dataset.theme = prefersLight ? "paper" : "void";
		})();
	</script>
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<title>{pageTitle}</title>
	<meta name="description" content={pageDescription} />
	{noindex && <meta name="robots" content="noindex" />}
	{!noindex && <link rel="canonical" href={`${siteUrl}${pathname}`} />}
	{pair && <link rel="alternate" hreflang="en" href={`${siteUrl}${pair[0]}`} />}
	{pair && <link rel="alternate" hreflang="cs" href={`${siteUrl}${pair[1]}`} />}

	<meta property="og:type" content="website" />
	<meta property="og:title" content={pageTitle} />
	<meta property="og:description" content={pageDescription} />
	<meta property="og:url" content={`${siteUrl}${pathname}`} />
	<meta property="og:image" content={`${siteUrl}/og-image.png`} />
	<meta property="og:locale" content={lang === "cz" ? "cs_CZ" : "en_US"} />

	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={pageTitle} />
	<meta name="twitter:description" content={pageDescription} />
	<meta name="twitter:image" content={`${siteUrl}/og-image.png`} />

	<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
</head>
<body>
<a class="skip-link" href="#content">{lang === "cz" ? "Přeskočit na obsah" : "Skip to content"}</a>

<header class="site-header">
	<div class="wrap header-inner">
		<a href={lang === "cz" ? "/cz/" : "/"} class="site-mark">Pavel Kleisner</a>
		<Nav lang={lang} />
	</div>
</header>

<main id="content" class="wrap" tabindex="-1">
	<slot />
</main>

<footer class="site-footer">
	<div class="wrap footer-grid">
		<div class="footer-links">
			<a href="mailto:contact@pavelkleisner.dev">contact@pavelkleisner.dev</a>
			<a href="https://github.com/JohnyIII" target="_blank" rel="noopener noreferrer">GitHub</a>
			<a href="https://www.linkedin.com/in/pavel-kleisner-895989129/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
		</div>
		<div class="footer-meta">
			<span>{labels.updated} {buildDate}</span>
			<a href="https://github.com/JohnyIII/pavelkleisner.dev" target="_blank" rel="noopener noreferrer">{labels.source}</a>
		</div>
	</div>
</footer>
<script>
	// Obsah vlevo zvýrazní sekci, ve které právě jsem.
	const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a[href^='#']")];
	if (links.length) {
		const byId = new Map(links.map((a) => [a.hash.slice(1), a]));
		const io = new IntersectionObserver((entries) => {
			for (const e of entries) {
				if (!e.isIntersecting) continue;
				links.forEach((a) => a.removeAttribute("aria-current"));
				byId.get(e.target.id)?.setAttribute("aria-current", "true");
			}
		}, { rootMargin: "-20% 0px -70% 0px" });
		byId.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
	}
</script>
</body>
</html>
