---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Contact - Pavel Kleisner">

    <section class="page-head">
        <div>
            <p class="muted" style="margin:0 0 .4rem"><span class="badge b-party">Looking for a party</span></p>
            <h1>Contact</h1>
            <p class="sub">Backend, integrations, a release to own, a production problem to untangle or tooling for AI agents? Send a short email and I'll tell you plainly whether I can help.</p>
        </div>
    </section>

    <div class="book">
        <nav class="toc" aria-label="On this page">
            <p>On this page</p>
            <a href="#email">Email</a>
            <a href="#elsewhere">Elsewhere</a>
            <a href="#together">Working together</a>
        </nav>
        <div>
            <section class="chapter" id="email">
                <h2>Email</h2>
                <p><a class="email-big" href="mailto:contact@pavelkleisner.dev">contact@pavelkleisner.dev</a></p>
                <p class="muted">The fastest way. A few lines about the problem, the context and the expected scope are enough.</p>
            </section>
            <section class="chapter" id="elsewhere">
                <h2>Elsewhere</h2>
                <dl class="rows">
                    <div><dt>LinkedIn</dt><dd><a href="https://www.linkedin.com/in/pavel-kleisner-895989129/" target="_blank" rel="noopener noreferrer">linkedin.com/in/pavel-kleisner-895989129</a>, professional background</dd></div>
                    <div><dt>GitHub</dt><dd><a href="https://github.com/JohnyIII" target="_blank" rel="noopener noreferrer">github.com/JohnyIII</a>, code and the source of this site</dd></div>
                </dl>
            </section>
            <section class="chapter" id="together">
                <h2>Working together</h2>
                <p>I'm a self-employed contractor, open to long-term and focused engagements, remotely from near Prague (CET). I fit best where backend behaviour, data, external contracts and production releases all matter at once, and I'm happy to help a team put AI agents to work on its own systems. I work best with a clear scope and direct communication.</p>
            </section>
        </div>
    </div>

</Layout>
