---
import Layout from "@/layouts/Layout.astro";

// Cloudflare Pages servíruje jednu 404.html pro všechny jazyky, proto je stránka dvojjazyčná.
---

<Layout title="404 - Page not found / Stránka nenalezena" noindex>
    <section class="not-found">
        <p style="margin:0 0 .6rem"><span class="badge b-boss">Game over</span></p>
        <h1>404</h1>
        <p class="sub">This page doesn't exist. Maybe a typo in the address or an old link.</p>
        <p class="sub" lang="cs">Tahle stránka neexistuje. Možná překlep v&nbsp;adrese nebo starý odkaz.</p>
        <div class="actions">
            <a href="/" class="btn">Back to the homepage</a>
            <a href="/cz/" lang="cs">Zpět na českou úvodní stránku</a>
        </div>
    </section>
</Layout>
