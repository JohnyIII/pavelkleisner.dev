---
import Layout from "@/layouts/Layout.astro";

const pathname = Astro.url.pathname;
const lang = pathname.startsWith("/cz") ? "cz" : "en";
const t = lang === "cz"
    ? {
        title: "404 - Stránka nenalezena",
        heading: "404",
        sub: "Route not found in router config",
        body: "Tahle stránka neexistuje. Možná překlep v adrese, starý odkaz, nebo jsem ji při úklidu zrefaktoroval pryč.",
        homeLabel: "Zpět na home",
        homeHref: "/cz",
        contactLabel: "Napsat",
        contactHref: "/cz/kontakt",
        stackTitle: "Stack trace",
        stackLines: [
            "RouteNotFoundException: no static route matched",
            `  at /pages router → "${pathname}"`,
            "  at src/pages/[404].astro",
            "  at user.expectations → reality",
            "Hint: zkontroluj URL nebo se vrať na hlavní stránku.",
        ],
    }
    : {
        title: "404 - Page not found",
        heading: "404",
        sub: "Route not found in router config",
        body: "This page doesn't exist. A typo in the address, an old link, or I refactored it away while tidying up.",
        homeLabel: "Back to home",
        homeHref: "/",
        contactLabel: "Send me a note",
        contactHref: "/contact",
        stackTitle: "Stack trace",
        stackLines: [
            "RouteNotFoundException: no static route matched",
            `  at /pages router → "${pathname}"`,
            "  at src/pages/[404].astro",
            "  at user.expectations → reality",
            "Hint: check the URL or head back to the homepage.",
        ],
    };

---

<Layout title={t.title}>
    <section class="not-found">
        <div class="code">404</div>
        <p class="lead" style="font-family:var(--font-display);font-size:1.4rem;margin:1rem 0">{t.body}</p>
        <p><a href={t.homeHref} class="btn primary">{t.homeLabel}</a> &nbsp; <a href={t.contactHref}>{t.contactLabel}</a></p>
        <pre aria-label={t.stackTitle}>{t.stackLines.map((line, i) => <span class={i === 0 ? "err" : undefined}>{line + "\n"}</span>)}</pre>
    </section>
</Layout>
